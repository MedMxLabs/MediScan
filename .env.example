# MedScan — gitignored secrets (also loaded by backend via app/env_loader.py)

# Flask / DB
FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///medscan.db

# JWT
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# AI — chatbot, lab insights, medicine fallback (OpenAI-compatible)
AZURE_OPENAI_API_BASE=https://YOUR-OPENAI-RESOURCE.openai.azure.com/openai/deployments/gpt-4.1-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-4.1-mini
MEDSCAN_AI_MEDICINE_FALLBACK=1

# Azure Document Intelligence — optional cloud OCR
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-read
MEDSCAN_AZURE_OCR=1

# Floating web widget (frontend only): frontend/.env → VITE_OMNIDIMENSION_WIDGET_SECRET

# OCR (Windows: full path to tesseract.exe)
TESSERACT_CMD=

# Playwright debug
PLAYWRIGHT_HEADED=

# Scraper proxy (Netmeds, TrueMeds, MedPlus from datacenter IPs)
SCRAPER_PROXY_URL=
SCRAPER_CONCURRENCY=6

# Supabase Auth (web + mobile — see docs/SUPABASE_WEB.md)
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=

# Google OAuth (optional — legacy when Supabase off)
GOOGLE_OAUTH_CLIENT_ID=

# Redis (optional)
REDIS_URL=

# CORS (production)
# CORS_ORIGINS=https://medscan.azurestaticapps.net
