# MedScan frontend — copy to .env.local for local overrides

# Production API base (no trailing slash). Leave unset in dev — Vite proxies /api → backend.
# Production (Azure Static Web Apps build) MUST set this to the live API:
# VITE_API_URL=https://medscan-api.azurewebsites.net
# VITE_MEDSCAN_API_KEY=  # same value as backend MEDSCAN_CLIENT_API_KEYS (when enforced)

# Supabase Auth — web login/signup (see docs/SUPABASE_WEB.md)
# Option A: set both below. Option B: set SUPABASE_* only in backend/.env (app loads config from API).
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional integrations
# VITE_OMNIDIMENSION_WIDGET_SECRET=
# VITE_APP_NAME=MedMx LABS

# Dev-only: backend proxy target (vite.config.js)
# MEDSCAN_API_PROXY=http://127.0.0.1:5000
