# MedScan backend — copy to .env and adjust (or use ../.env at repo root; both are loaded)

# Flask
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-bytes
FLASK_ENV=development
DATABASE_URL=sqlite:///medscan.db
MEDSCAN_UPLOAD_FOLDER=uploads

# OCR (open-source: PyMuPDF + pdfplumber + Tesseract + RapidOCR)
# Windows: install Tesseract from https://github.com/UB-Mannheim/tesseract/wiki
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=eng
MEDSCAN_OCR_MIN_CHARS=12

# Azure Document Intelligence — cloud OCR upgrade (prebuilt-read)
# Create in Azure Portal → Document Intelligence; paste endpoint + key below
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-read
MEDSCAN_AZURE_OCR=1

# Azure OpenAI — gpt-4.1-mini deployment (Standard, 1K TPM)
AZURE_OPENAI_API_BASE=https://YOUR-OPENAI-RESOURCE.openai.azure.com/openai/deployments/gpt-4.1-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
MEDSCAN_AI_MEDICINE_FALLBACK=1

# Disable background jobs / rate limits for local tests
# MEDSCAN_DISABLE_SCHEDULER=1
# MEDSCAN_DISABLE_RATE_LIMIT=1

# Redis (optional — OCR upload cache + scrape retry queue)
# REDIS_URL=redis://localhost:6379/0

# Email / SMS reminders
# MEDSCAN_SMTP_HOST=smtp.example.com
# MEDSCAN_SMTP_PORT=587
# MEDSCAN_SMTP_USER=
# MEDSCAN_SMTP_PASSWORD=
# MEDSCAN_SMTP_FROM=medscan@example.com
# MEDSCAN_SMS_WEBHOOK_URL=

# Supabase Auth (optional — email, Google, password reset via Supabase)
# Dashboard → Project Settings → API: URL + anon key; JWT Settings → JWT Secret
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=

# Scraping
# SCRAPER_PROXY_URL=
# SCRAPER_CONCURRENCY=6

# CORS (production): comma-separated frontend origins
# CORS_ORIGINS=https://your-app.azurestaticapps.net

# Client API key — mobile/web send header X-Medscan-Api-Key (JWT still required per user)
# Generate: python scripts/generate_client_api_key.py
# MEDSCAN_CLIENT_API_KEYS=your-generated-key
# Mobile: flutter run --dart-define=MEDSCAN_API_KEY=your-generated-key
# Web:   VITE_MEDSCAN_API_KEY=your-generated-key npm run build

# Setup check: python scripts/check_setup.py